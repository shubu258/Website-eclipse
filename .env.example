# "Book a call" form -> email (app/api/book/route.ts)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where form submissions are delivered (defaults to BOOK_EMAIL in components/contact.ts)
BOOK_TO_EMAIL=shivanshnigam2582@gmail.com

# Sender shown on the email. Resend's test sender only delivers to your own Resend
# account email; once you verify a domain on Resend, use e.g. "Takksh <hello@yourdomain.com>"
BOOK_FROM_EMAIL=Takksh Website <onboarding@resend.dev>
